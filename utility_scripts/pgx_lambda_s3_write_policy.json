{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PgxRiskCalculatorWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::jerome-dixon.io/vcu/pgx-risk-calculator/*"
    },
    {
      "Sid": "PgxRiskCalculatorList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jerome-dixon.io",
      "Condition": {
        "StringLike": {
          "s3:prefix": "vcu/pgx-risk-calculator/*"
        }
      }
    }
  ]
}
