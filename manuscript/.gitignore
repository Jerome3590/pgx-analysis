/.quarto/

# Python cache
__pycache__/
*.pyc
*.pyo

# Node modules (root-level Puppeteer install)
node_modules/

# Generated build artifacts — do not commit
output/*.pdf
output/*.tex
output/*.log
output/*.html
output/CH_*/
output/figures/
output/edits/
output/final_submission/
output/submission/

# PNG figure artifacts — canonical format is PDF
figures/**/*.png
CH_1/Literature_Review/figures/*.png

# Literature review generated log/data CSVs (large, auto-generated)
CH_1/Literature_Review/scripts/*.csv

# Sample files (unrelated papers — not part of this dissertation)
samples/

# LaTeX intermediates left by keep-tex: true
CH_*/*.tex
CH_*/*.aux
CH_*/*.bbl
CH_*/*.blg
CH_*/*.log
CH_*/*.out
CH_*/*.toc

# In-source PDFs — canonical output is output/*.pdf via build.ps1
CH_*/*.pdf

# Quarto render cache
*_files/

# Wiley extension copies cls/bst/sty resources into each chapter dir during build
CH_*/*.cls
CH_*/*.sty
CH_*/*.bst
CH_*/Fonts/
CH_*/CH*/
CH_*/*.pag

# Lambda local outputs and logs (large data files)
infrastructure_setup/lambda_local/outputs/
infrastructure_setup/lambda_local/cohort_logs/
