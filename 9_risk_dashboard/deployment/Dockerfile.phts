# Dockerfile for PHTS Lambda Container Image
# Supports up to 10GB container size for model storage

FROM public.ecr.aws/lambda/python:3.11

# Install system dependencies
# Note: Amazon Linux 2 has GCC 7.3.1, but NumPy 1.24+ requires GCC 9.3+
# We'll use pre-built wheels to avoid compilation issues
RUN yum install -y gcc gcc-c++ cmake make && \
    yum clean all && \
    rm -rf /var/cache/yum

# Copy requirements and install Python dependencies
COPY phts_requirements.txt ${LAMBDA_TASK_ROOT}/requirements.txt
# Install dependencies using pre-built wheels when available
# This avoids compilation issues with GCC version requirements
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --prefer-binary -r ${LAMBDA_TASK_ROOT}/requirements.txt -t ${LAMBDA_TASK_ROOT}

# Copy Lambda function code
COPY phts_lambda_function.py ${LAMBDA_TASK_ROOT}

# Copy models directory (prepared by prepare_lambda_dir_phts.py)
# Models are copied directly to /var/task/models/ for fast access
COPY lambda_dir_phts/models/ ${LAMBDA_TASK_ROOT}/models/

# Copy model features (feature metadata)
COPY lambda_dir_phts/model_features/ ${LAMBDA_TASK_ROOT}/model_features/

# Copy dashboard data directory
COPY lambda_dir_phts/dashboard_data/ ${LAMBDA_TASK_ROOT}/dashboard_data/

# Copy risk distributions for normalization
COPY lambda_dir_phts/risk_distributions/ ${LAMBDA_TASK_ROOT}/risk_distributions/

# Set working directory
WORKDIR ${LAMBDA_TASK_ROOT}

# Set Lambda handler
CMD [ "phts_lambda_function.lambda_handler" ]
