direction: down

title: "Polypharmacy Adverse Drug Event (ADE) Cohort Pipeline (ed_non_opioid)" {
  near: top-center
  shape: text
  style: {
    font-size: 28
    bold: true
    underline: true
    fill: "#1E293B"
  }
}

# -----------------------------------------------------------------------------
# Phase 0: Raw Claims Data Ingestion
# -----------------------------------------------------------------------------
phase0: "Phase 0: Virginia APCD Longitudinal Lake (2016–2020)" {
  style: {
    fill: "#F8FAFC"
    stroke: "#64748B"
    stroke-width: 2
    border-radius: 8
  }

  med_claims: "Medical Claims Lake\n(All-Payer Encounters, HCG Detail Codes, ICD-10 Positions 1–10)" {
    shape: cylinder
    style.fill: "#E2E8F0"
  }
  rx_claims: "Pharmacy Claims Lake\n(Adjudicated Dispenses, NDC to Generic RxNorm, Days Supply)" {
    shape: cylinder
    style.fill: "#E2E8F0"
  }
  partitions: "Annual Partitions (2016, 2017, 2018, 2019)\nStratified into 8 Age Bands (0–12 to 85–114)" {
    shape: rectangle
    style.fill: "#F1F5F9"
  }

  med_claims -> partitions
  rx_claims -> partitions
}

# -----------------------------------------------------------------------------
# Phase 1: Case Identification & Absolute Cleanse
# -----------------------------------------------------------------------------
phase1: "Phase 1: Case Anchor & Opioid Cleanse (phase1_data_preparation.py)" {
  style: {
    fill: "#FEF2F2"
    stroke: "#EF4444"
    stroke-width: 2
    border-radius: 8
  }

  hcg_scanner: "Milliman HCG Clinical Emergency Anchor\nTarget Codes: P51b (ER), O11 (ER Services), P33 (Outpatient Observation)\nTarget Timestamp: first_ed_non_opioid_date (t₀)" {
    shape: rectangle
    style.fill: "#FEE2E2"
  }

  opioid_cleanse: "Absolute Opioid Cleanse Boundary\nStrictly drops any patient with ANY opioid ICD-10 code\n(F11.* or T40.*) across all 10 diagnosis columns in study year\nGuarantees 100% mutual exclusivity with opioid cohort" {
    shape: diamond
    style: {
      fill: "#FCA5A5"
      stroke: "#DC2626"
      bold: true
    }
  }

  hcg_scanner -> opioid_cleanse: "Raw ED Candidates"
}

# -----------------------------------------------------------------------------
# Phase 2: Sequential Clinical Filtering Funnel (True ADE Isolation)
# -----------------------------------------------------------------------------
phase2: "Phase 2: Sequential ADE Filtering Funnel (phase2_event_processing.py)" {
  style: {
    fill: "#FFFBEB"
    stroke: "#F59E0B"
    stroke-width: 2
    border-radius: 8
  }

  filter1_utilization: "Filter 1: ED Utilization Cap (< 7 ED Visits/Year)\n• Excludes chronic crisis utilizers ('flyers')\n• Removes severe socio-environmental crisis noise\n• Isolates true acute medication-mediated emergencies" {
    shape: step
    style: {
      fill: "#FEF3C7"
      stroke: "#D97706"
    }
  }

  filter2_proximity: "Filter 2: Proximal Drug Exposure Window (1–21 Days Pre-ED)\n• Patient must have active pharmacy dispensing 1–21 days prior\n• FDA FAERS Pharmacokinetic Validation (qa_faers_time_to_onset.py):\n  21-day window captures ~90.5% of all acute ADE time-to-onset distributions" {
    shape: step
    style: {
      fill: "#FDE68A"
      stroke: "#D97706"
      bold: true
    }
  }

  filter3_discharge: "Filter 3: Zero-Day Discharge-Fill Guard\n• STRICTLY PURGES all prescriptions dispensed on Day 0 (t₀)\n• Clinical Rationale: Day 0 claims represent discharge meds\n  (e.g., antiemetics, antibiotics, analgesics) prescribed AFTER the visit\n• Prevents immediate reverse-causality target leakage" {
    shape: callout
    style: {
      fill: "#FCD34D"
      stroke: "#B45309"
      bold: true
    }
  }

  filter1_utilization -> filter2_proximity: "Pass Filter 1"
  filter2_proximity -> filter3_discharge: "Pass Filter 2"
}

# -----------------------------------------------------------------------------
# Phase 3: Acute Lookback Horizon & Feature Representation
# -----------------------------------------------------------------------------
phase3: "Phase 3: Acute Exposure Horizon & Feature Engineering" {
  style: {
    fill: "#F5F3FF"
    stroke: "#8B5CF6"
    stroke-width: 2
    border-radius: 8
  }

  acute_horizon: "21–30 Day Acute Pre-Index Window\n[t₀ - 21/30 days  →  t₀ - 1 day]\n• Active Multi-Drug Concurrency & Drug-Drug Interactions\n• Beers Criteria High-Risk Medications in Older Adults\n• Anticholinergic & Sedative Cumulative Burden\n• Sudden Titrations & Recent Regimen Modifications" {
    shape: rectangle
    style.fill: "#EDE9FE"
  }

  toolbox_demarcation: "Toolbox Demarcation Architecture\n• Tabular Counts & Claims-Density Bins (P25/P50/P95) → Tree Feature Matrix\n• bupaR Process Flows, DTW Clusters & FP-Growth Rules → Dashboard Only\n• Locked 682-Feature Pre-Index Whitelist Enforced" {
    shape: stored_data
    style: {
      fill: "#DDD6FE"
      stroke: "#7C3AED"
      bold: true
    }
  }

  acute_horizon -> toolbox_demarcation: "Extract Whitelist"
}

# -----------------------------------------------------------------------------
# Phase 4: 1:5 Matched Case–Control Sampling
# -----------------------------------------------------------------------------
phase4: "Phase 4: 1:5 Matched Control Sampling (phase3_cohort_creation.py)" {
  style: {
    fill: "#F0FDF4"
    stroke: "#22C55E"
    stroke-width: 2
    border-radius: 8
  }

  control_candidates: "Eligible Control Pool\n• Covered APCD members in same partition year\n• Zero qualifying ED visits in study year\n• Verified health system contact continuity" {
    shape: rectangle
    style.fill: "#DCFCE7"
  }

  matching_engine: "1:5 Incidence-Density Matching (No Replacement)\nExact Stratification On:\n1. Age Band (8 Strata: 0–12, 13–24, 25–44, ..., 85–114)\n2. Biological Sex (Exact M/F Match)\n3. Calendar Year Partition (2016–2019)\n4. Active Coverage Continuity" {
    shape: hexagon
    style: {
      fill: "#BBF7D0"
      bold: true
    }
  }

  pseudo_index: "Pseudo-Index Reference Date (t_pseudo)\nControls assigned earliest non-ED medical claim date\nGuarantees identical 21-day pre-index baseline window" {
    shape: step
    style.fill: "#86EFAC"
  }

  control_candidates -> matching_engine: "Candidate Pool"
  matching_engine -> pseudo_index: "Assign Anchor"
}

# -----------------------------------------------------------------------------
# Phase 5: Automated QA Integrity & S3 Persistence
# -----------------------------------------------------------------------------
phase5: "Phase 5: QA Assertion & Checkpointed Export (phase4_finalization.py)" {
  style: {
    fill: "#EFF6FF"
    stroke: "#3B82F6"
    stroke-width: 2
    border-radius: 8
  }

  duckdb_qa: "DuckDB QA Unit Assertion (qa_index_date_uniqueness.py)\nSELECT mi_person_key, count(DISTINCT first_ed_non_opioid_date)\nHAVING count > 1;\nAsserts EXACTLY ONE index date per person-year" {
    shape: code
    style: {
      fill: "#DBEAFE"
      stroke: "#2563EB"
    }
  }

  cell_suppression: "Cell-Size Suppression Guard\nSuppresses n ≤ 10 cell counts per CMS/VHI privacy policy" {
    shape: rectangle
    style.fill: "#BFDBFE"
  }

  s3_parquet: "Final Parquet Fact Table (s3://pgx-repository/cohorts/)\n• schema: final_cohort_schema.json\n• Cases + 5:1 Controls with 682 Whitelisted Features\n• Checkpointed to S3 pgx-pipeline-status/" {
    shape: cylinder
    style: {
      fill: "#93C5FD"
      bold: true
    }
  }

  duckdb_qa -> cell_suppression: "QA Passed"
  cell_suppression -> s3_parquet: "Write Gold Artifact"
}

# -----------------------------------------------------------------------------
# Cross-Phase Pipeline Connections
# -----------------------------------------------------------------------------
phase0.partitions -> phase1.hcg_scanner: "Claims Stream"
phase0.partitions -> phase4.control_candidates: "Enrollment Roster"

phase1.opioid_cleanse -> phase2.filter1_utilization: "Cleaned ED Cases"
phase2.filter3_discharge -> phase3.acute_horizon: "Validated ADE Cases"
phase2.filter3_discharge -> phase4.matching_engine: "1 Target Case"

phase4.pseudo_index -> phase3.acute_horizon: "5 Matched Controls"
phase3.toolbox_demarcation -> phase5.duckdb_qa: "Tabular Feature Matrix"
