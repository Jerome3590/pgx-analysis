# Explicitly allow this code companion.
!README.md
!.gitignore
!code/
!code/**
!code/**/*.py
!code/**/*.R
!code/**/*.yaml
!code/**/*.yml
!code/**/*.md
!artifacts/
!artifacts/**
!artifacts/**/*.csv
!artifacts/**/*.md

# Re-assert runtime exclusions after allowlist exceptions.
__pycache__/
**/__pycache__/
*.pyc
